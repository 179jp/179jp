---
// props
const {
  level = "p",
  size = "m",
  font = "",
  align = "center",
  vertical = false,
  color = "",
  colorRGB = "",
  width = "",
  height = "",
  padding = "",
} = Astro.props;

// Class
const classArray = [`exh-text`, `font-size-${size}`, `align-${align}`];
if (font) {
  classArray.push(`font-${font}`);
}
if (vertical) {
  classArray.push(`exh-text-vertical`);
}
if (color) {
  classArray.push(`color-${color}`);
}
const classList = classArray.join(" ");

// Style
const styleArray = [];
if (colorRGB) {
  styleArray.push(`color: ${colorRGB}`);
}
if (width) {
  styleArray.push(`width: ${width}`);
}
if (height) {
  styleArray.push(`height: ${height}`);
}
if (padding) {
  styleArray.push(`padding: ${padding}`);
}
const styleList = styleArray.join(";");
---

{
  level === "p" && (
    <div class={classList} style={styleList}>
      <slot />
    </div>
  )
}
{
  level === "h1" && (
    <h1 class={classList} style={styleList}>
      <slot />
    </h1>
  )
}
{
  level === "h2" && (
    <h2 class={classList} style={styleList}>
      <slot />
    </h2>
  )
}
{
  level === "h3" && (
    <h3 class={classList} style={styleList}>
      <slot />
    </h3>
  )
}
