---
// トップ記事。右から 大見出し（3 列）・副見出し（3 列、なければ置かない）・本文（残り）
import Lead from "../parts/Lead.astro";
import Body from "../parts/Body.astro";
import type { Area, TopStoryData } from "../types";

interface Props {
  area: Area;
  story: TopStoryData;
  /** エディター用。YAML での記事の場所（例 "articles.0"）。渡したときだけ data-edit を付ける */
  field?: string;
}

const LEAD_COLS = 3;
const SUB_COLS = 3;

const { area, story, field } = Astro.props;
const edit = (key: string) => (field ? `${field}.${key}` : undefined);
const [start, end] = area.col;
const subStart = start + LEAD_COLS;
const bodyStart = subStart + (story.sub ? SUB_COLS : 0);
---

<Lead area={{ col: [start, subStart], row: area.row }} text={story.lead} edit={edit("lead")} />
{
  story.sub && (
    <Lead
      area={{ col: [subStart, bodyStart], row: area.row }}
      text={story.sub}
      size="sub"
      edit={edit("sub")}
    />
  )
}
<Body area={{ col: [bodyStart, end], row: area.row }} paragraphs={story.body} edit={edit("body")} />
