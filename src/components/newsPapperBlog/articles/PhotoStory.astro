---
// 写真記事。上の段に 見出し（3 列、sub がなければ 2 列）・写真・キャプション（1 列）、下の段に本文。
// 見出し（title の項目も sub も）がなければ、見出しの列を写真に回す。title: "" は空の見出しとして列を残す
// layout: large は本文なし。写真を欄の高さいっぱいに広げ、キャプションを写真の下に横書きで置く（2 行まで）
import Head from "../parts/Head.astro";
import Photo from "../parts/Photo.astro";
import Caption from "../parts/Caption.astro";
import Body from "../parts/Body.astro";
import type { Area, PhotoStoryData } from "../types";
import { hasHead as hasHeadOf } from "../head";

interface Props {
  area: Area;
  story: PhotoStoryData;
  /** 写真に使う段数。残りの段が本文になる */
  photoTiers?: number;
  /** 本文の右端を写真の右端にそろえる（見出しの下には本文を入れない） */
  alignBody?: boolean;
  /** エディター用。YAML での記事の場所（例 "articles.0"）。渡したときだけ data-edit を付ける */
  field?: string;
}

// 見出しの列数。sub がなければ見出しだけの 2 列にして写真に回す
const HEAD_COLS = { withSub: 3, titleOnly: 2 };
const CAPTION_COLS = 1;
/** large のとき、写真の下に空けるキャプションの高さ（xs の文字で 2 行＋写真との間） */
const CAPTION_BELOW = "calc(var(--np-fs-xs) * 1.5 * 2 + 0.5em)";

const { area, story, photoTiers = 2, alignBody = false, field } = Astro.props;
const edit = (key: string) => (field ? `${field}.${key}` : undefined);
const [start, end] = area.col;
const hasHead = hasHeadOf(story);
const headCols = !hasHead ? 0 : story.sub ? HEAD_COLS.withSub : HEAD_COLS.titleOnly;
const photoStart = start + headCols;
const large = story.layout === "large";
const captionStart = large ? end : end - CAPTION_COLS;
const photoRow = large ? area.row : ([area.row[0], area.row[0] + photoTiers] as const);
const bodyRow = [photoRow[1], area.row[1]] as const;

// sub がないとき、見出しの 2 列（2em ＋ 行間）と写真との行間に対して、タイトルは 1 行ぶんの幅しかない。
// 写真を見出し側へ広げて、タイトルとの間を 0.4em に詰める
const TITLE_GAP = "0.4em";
const extendRight =
  hasHead && !story.sub
    ? `(2em + 2 * var(--np-line-gap) - var(--np-fs-photo-head) - ${TITLE_GAP})`
    : undefined;

// 本文を写真にそろえるとき。写真を見出し側へ広げた分（約 1 列）は、本文も 1 列右から始める
const bodyStart = !alignBody
  ? start
  : extendRight
    ? photoStart - 1
    : photoStart;
---

{
  hasHead && (
    <Head
      area={{ col: [start, photoStart], row: photoRow }}
      title={story.title}
      sub={story.sub}
      variant="photo"
      field={field}
    />
  )
}
<Photo
  area={{ col: [photoStart, captionStart], row: photoRow }}
  photo={story.photo}
  extendRight={extendRight}
  reserveBottom={large ? CAPTION_BELOW : undefined}
  edit={edit("photo")}
/>
{
  large ? (
    <Caption
      area={{ col: [photoStart, end], row: photoRow }}
      text={story.caption}
      variant="below"
      edit={edit("caption")}
    />
  ) : (
    <>
      <Caption area={{ col: [captionStart, end], row: photoRow }} text={story.caption} edit={edit("caption")} />
      <Body area={{ col: [bodyStart, end], row: bodyRow }} paragraphs={story.body ?? []} edit={edit("body")} />
    </>
  )
}
