---
// 木漏れ日の中の K チェア（カリモク60）のイラスト
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<svg
  viewBox="0 0 120 186"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={label}
>
  <defs>
    <pattern
      id="np-k-dot-s"
      width="5"
      height="5"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="2.5" cy="2.5" r="0.9" fill="currentColor"></circle>
    </pattern>
    <pattern
      id="np-k-dot-f"
      width="3"
      height="3"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="1.5" cy="1.5" r="0.55" fill="currentColor"></circle>
    </pattern>
    <pattern
      id="np-k-dot-m"
      width="4"
      height="4"
      patternUnits="userSpaceOnUse"
    >
      <rect width="4" height="4" class="bg"></rect>
      <circle cx="2" cy="2" r="1.2" fill="currentColor"></circle>
    </pattern>
    <pattern
      id="np-k-dot-l"
      width="4"
      height="4"
      patternUnits="userSpaceOnUse"
    >
      <rect width="4" height="4" class="bg"></rect>
      <circle cx="2" cy="2" r="1.6" fill="currentColor"></circle>
    </pattern>
  </defs>

  <!-- 壁と床。木漏れ日は網点を抜いた穴で描く -->
  <rect width="120" height="186" class="bg"></rect>
  <rect width="120" height="130" fill="url(#np-k-dot-s)"></rect>
  <rect y="130" width="120" height="56" fill="url(#np-k-dot-f)"></rect>
  <g stroke="currentColor" stroke-width="0.6">
    <line x1="0" y1="137" x2="120" y2="137"></line>
    <line x1="0" y1="147" x2="120" y2="147"></line>
    <line x1="0" y1="161" x2="120" y2="161"></line>
    <line x1="0" y1="180" x2="120" y2="180"></line>
  </g>
  <line
    x1="0"
    y1="130"
    x2="120"
    y2="130"
    stroke="currentColor"
    stroke-width="1.2"></line>
  <g class="bg">
    <circle cx="12" cy="24" r="10"></circle><circle cx="25" cy="32" r="6"
    ></circle><circle cx="6" cy="40" r="5"></circle>
    <circle cx="30" cy="16" r="4"></circle><circle cx="20" cy="50" r="3.5"
    ></circle><circle cx="38" cy="30" r="2.5"></circle>
    <circle cx="98" cy="30" r="6"></circle><circle cx="108" cy="22" r="3.5"
    ></circle><circle cx="90" cy="40" r="2.5"></circle>
    <circle cx="70" cy="12" r="3"></circle>
    <ellipse cx="20" cy="168" rx="14" ry="5"></ellipse>
    <ellipse cx="38" cy="178" rx="8" ry="3"></ellipse>
    <ellipse cx="8" cy="154" rx="6" ry="2.5"></ellipse>
    <ellipse cx="100" cy="176" rx="10" ry="3.5"></ellipse>
  </g>

  <g
    transform="translate(-9,-2)"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linejoin="round"
  >
    <!-- 床に落ちる影 -->
    <polygon
      points="30,162 96,162 124,148 58,148"
      fill="url(#np-k-dot-l)"
      stroke="none"></polygon>

    <!-- 奥の脚 -->
    <rect x="38" y="93" width="6" height="60" class="bg"></rect>
    <rect x="104" y="93" width="6" height="60" class="bg"></rect>

    <!-- 背もたれ -->
    <polygon points="48,60 108,60 114,56 54,56" class="bg"></polygon>
    <polygon points="44,111 104,111 108,60 48,60" fill="url(#np-k-dot-m)"
    ></polygon>
    <path d="M47,82 L106,82" stroke-width="0.8" stroke-dasharray="1.5 2"
    ></path>

    <!-- 座面 -->
    <polygon points="30,118 90,118 104,109 44,109" class="bg"></polygon>
    <polygon points="30,118 90,118 90,130 30,130" fill="url(#np-k-dot-l)"
    ></polygon>

    <!-- 手前の枠（肘掛け・前脚・貫） -->
    <g class="bg">
      <polygon points="38,151 24,160 24,156 38,147"></polygon>
      <polygon points="104,151 90,160 90,156 104,147"></polygon>
      <rect x="24" y="102" width="6" height="58"></rect>
      <rect x="90" y="102" width="6" height="58"></rect>
      <polygon points="24,98 30,98 44,89 38,89"></polygon>
      <polygon points="90,98 96,98 110,89 104,89"></polygon>
      <rect x="24" y="98" width="6" height="5"></rect>
      <rect x="90" y="98" width="6" height="5"></rect>
    </g>
    <polygon points="30,98 44,89 44,94 30,103" fill="currentColor"></polygon>
    <polygon points="96,98 110,89 110,94 96,103" fill="currentColor"
    ></polygon>
  </g>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--np-color-ink);
  }
  .bg {
    fill: var(--np-color-photo);
  }
</style>
