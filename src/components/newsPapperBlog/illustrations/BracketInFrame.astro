---
// 活字の枠（字面）の右寄りに入った、全角の始めかっこ「（」のイラスト
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<svg
  viewBox="0 0 120 186"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={label}
>
  <defs>
    <pattern
      id="np-bracket-in-frame-dot-s"
      width="5"
      height="5"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="2.5" cy="2.5" r="0.9" fill="currentColor"></circle>
    </pattern>
    <pattern
      id="np-bracket-in-frame-dot-f"
      width="3"
      height="3"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="1.5" cy="1.5" r="0.55" fill="currentColor"></circle>
    </pattern>
  </defs>

  <!-- 枠の外の背景 -->
  <rect width="120" height="186" class="bg"></rect>
  <rect width="120" height="186" fill="url(#np-bracket-in-frame-dot-s)"></rect>

  <!-- 大きな字面の枠。左側の空きを細かい網点で塗る -->
  <rect x="12" y="45" width="96" height="96" class="bg"></rect>
  <rect x="12" y="45" width="50" height="96" fill="url(#np-bracket-in-frame-dot-f)"
  ></rect>
  <rect
    x="12"
    y="45"
    width="96"
    height="96"
    fill="none"
    stroke="currentColor"
    stroke-width="1.2"></rect>
  <!-- 枠の中心線（破線） -->
  <path
    d="M60,45 V141 M12,93 H108"
    stroke="currentColor"
    stroke-width="0.8"
    stroke-dasharray="3 2"></path>

  <!-- 全角の始めかっこ「（」。枠の右半分に寄っている -->
  <path
    d="M88,53 C60,73 60,113 88,133 L91.5,129.5 C70,111 70,75 91.5,56.5 Z"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="1.2"
    stroke-linejoin="round"></path>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--np-color-ink);
  }
  .bg {
    fill: var(--np-color-photo);
  }
</style>
