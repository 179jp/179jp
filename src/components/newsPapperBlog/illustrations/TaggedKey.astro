---
// 机の上に置かれた、荷札をひもで結んだ昔ながらの鍵のイラスト
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<svg
  viewBox="0 0 120 186"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label={label}
>
  <defs>
    <pattern
      id="np-tagged-key-dot-f"
      width="3"
      height="3"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="1.5" cy="1.5" r="0.55" fill="currentColor"></circle>
    </pattern>
    <pattern
      id="np-tagged-key-dot-m"
      width="4"
      height="4"
      patternUnits="userSpaceOnUse"
    >
      <rect width="4" height="4" class="bg"></rect>
      <circle cx="2" cy="2" r="1.2" fill="currentColor"></circle>
    </pattern>
    <pattern
      id="np-tagged-key-dot-l"
      width="4"
      height="4"
      patternUnits="userSpaceOnUse"
    >
      <rect width="4" height="4" class="bg"></rect>
      <circle cx="2" cy="2" r="1.6" fill="currentColor"></circle>
    </pattern>
  </defs>

  <!-- 机の天板（網点と木目） -->
  <rect width="120" height="186" class="bg"></rect>
  <rect width="120" height="186" fill="url(#np-tagged-key-dot-f)"></rect>
  <g fill="none" stroke="currentColor" stroke-width="0.7">
    <path d="M0,22 Q40,16 70,24 T120,20"></path>
    <path d="M0,70 Q30,64 64,72 T120,66"></path>
    <path d="M0,176 Q36,170 70,178 T120,172"></path>
  </g>

  <!-- 荷札 -->
  <g transform="translate(64,134) rotate(30)" stroke="currentColor">
    <polygon
      points="3,10 11,4 49,4 49,36 11,36 3,30"
      fill="url(#np-tagged-key-dot-l)"
      stroke="none"></polygon>
    <polygon
      points="0,6 8,0 46,0 46,32 8,32 0,26"
      class="bg"
      stroke-width="1.3"
      stroke-linejoin="round"></polygon>
    <!-- 穴の補強の丸と穴 -->
    <circle cx="9" cy="16" r="5" fill="none" stroke-width="1"></circle>
    <circle cx="9" cy="16" r="2" fill="currentColor" stroke="none"></circle>
  </g>

  <!-- 鍵。左下に持ち手、右上に先 -->
  <g
    transform="translate(24,144) rotate(-60) scale(1.12)"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linejoin="round"
  >
    <!-- 影 -->
    <g fill="url(#np-tagged-key-dot-l)" stroke="none" transform="translate(-3,5)">
      <circle cx="0" cy="0" r="16"></circle>
      <rect x="14" y="-4" width="98" height="8"></rect>
      <rect x="88" y="0" width="18" height="22"></rect>
    </g>
    <!-- 持ち手の輪 -->
    <circle cx="0" cy="0" r="16" class="bg"></circle>
    <path d="M-11,9 A14,14 0 0 0 13,6" fill="none" stroke-width="2.4"></path>
    <circle cx="0" cy="0" r="8" fill="url(#np-tagged-key-dot-f)"></circle>
    <!-- 軸と根元の飾り -->
    <rect x="16" y="-4" width="96" height="8" class="bg"></rect>
    <rect x="16" y="1" width="96" height="3" fill="currentColor" stroke="none"
    ></rect>
    <rect x="18" y="-6.5" width="5" height="13" class="bg"></rect>
    <rect x="26" y="-5.5" width="3.5" height="11" class="bg"></rect>
    <!-- 先の歯 -->
    <path
      d="M88,4 H106 V22 H100 V16 H96 V22 H88 Z"
      class="bg"></path>
    <path d="M88,10 H106" stroke-width="1"></path>
    <path d="M112,-4 Q117,0 112,4" class="bg"></path>
  </g>

  <!-- ひも。荷札の穴から鍵の輪へ -->
  <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
    <path d="M63.8,152.4 C54,166 40,166 33,154 Q31,151 30,149"></path>
    <path d="M63.8,152.4 C56,148 48,152 41,158"></path>
    <path d="M63.8,152.4 Q64,160 60,166"></path>
  </g>
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--np-color-ink);
  }
  .bg {
    fill: var(--np-color-photo);
  }
</style>
