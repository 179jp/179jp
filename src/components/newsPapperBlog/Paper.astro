---
// 紙面の外枠。題字欄・枠・グリッド・ガイドを用意し、記事は slot に並べる。
// slot="mobile" があれば、モバイルではグリッドの代わりにそちらを出す
import Masthead from "./Masthead.astro";
import Grid from "./Grid.astro";
import GuideToggle from "./GuideToggle.astro";
import Footer from "./Footer.astro";
import type { IssueLink } from "./issues";
import type { MastheadData } from "./types";

interface Props {
  masthead: MastheadData;
  /** 下書きの号なら、画面の隅に DRAFT と出す（開発サーバーでだけ見える） */
  draft?: boolean;
  /** 前の日・次の日の号 */
  prev?: IssueLink;
  next?: IssueLink;
}

const { masthead, draft = false, prev, next } = Astro.props;
const hasMobile = Astro.slots.has("mobile");
---

<div class:list={["paper", { "has-mobile": hasMobile }]}>
  <Masthead {...masthead} />
  <GuideToggle />
  {draft && <p class="draft">DRAFT</p>}
  <div class="frame" data-np-frame>
    <Grid>
      <slot />
    </Grid>
  </div>
  {
    hasMobile && (
      <div class="mobile">
        <slot name="mobile" />
      </div>
    )
  }
  <Footer prev={prev} next={next} />
</div>

{
  import.meta.env.DEV && (
    <script is:inline>
      // 開発中だけ：本文が枠に入りきらない記事に赤枠を付ける
      const markOverflow = () =>
        document.querySelectorAll("[data-np-body]").forEach((el) => {
          const over =
            el.scrollWidth > el.clientWidth + 1 ||
            el.scrollHeight > el.clientHeight + 1;
          el.style.outline = over ? "2px solid #e14d17" : "";
          el.title = over ? "本文が入りきっていません" : "";
        });
      addEventListener("load", markOverflow);
      addEventListener("resize", markOverflow);
    </script>
  )
}

<style>
  .paper {
    font-size: var(--np-base-font-size);
    width: 100%;
    padding: 1em 0;
    background-color: var(--np-color-paper);
    color: var(--np-color-ink);
  }

  .draft {
    position: fixed;
    right: 1rem;
    bottom: 3.5rem;
    z-index: 10;
    margin: 0;
    padding: 0.5em 1em;
    font-size: var(--np-fs-meta);
    letter-spacing: var(--np-ls-l);
    color: var(--np-color-paper);
    background-color: var(--np-color-guide-number);
  }

  .frame {
    position: relative;
    width: calc(100% - 4em);
    margin: 0 auto;
    padding: 1em;
    border-block: var(--np-rule);
    /* hidden だと縦にスクロールバーが出て、ガイドの行番号ではみ出したときに紙面がずれる */
    overflow-x: clip;
    /* 左右の縦罫 */
    &::before,
    &::after {
      content: "";
      position: absolute;
      top: 0;
      width: var(--np-rule-width);
      height: 100%;
      background-color: var(--np-color-rule);
    }
    &::before {
      left: 0;
    }
    &::after {
      right: 0;
    }
  }

  /* ---- モバイル ----
     左右の余白・罫なしで画面幅いっぱい（最大 600px）に使い、--np-m-lines 行が収まる文字サイズにする。
     題字欄・フッターも同じ幅にそろえ、文字の位置はブロックの内側の余白（--np-m-padding）に合わせる */
  .mobile {
    display: none;
  }
  @media (max-width: 768px) {
    .has-mobile {
      --np-m-width: min(100cqw, 600px);
      --np-m-padding: 8px;
      /* ブロックの左右の余白と、本文が行末側へはみ出す分（数 px）を引いた幅 */
      --np-font-size: calc(
        (var(--np-m-width) - 2 * var(--np-m-padding) - 4px) /
          (var(--np-m-lines) * var(--np-lh))
      );
    }
    .has-mobile .frame {
      display: none;
    }
    .has-mobile .mobile {
      display: block;
      width: var(--np-m-width);
      margin: 0 auto;
      border-block: var(--np-rule);
    }
  }
</style>
