---
// 写真のキャプション。段の下端にそろえる
import Text from "./Text.astro";
import type { Area, RichText } from "../types";
import { place } from "../utils";

interface Props {
  area: Area;
  text: RichText;
  /** エディター用。YAML での場所（例 "top.lead"） */
  edit?: string;
}

const { area, text, edit } = Astro.props;
---

<p class="np-cell caption" style={place(area)}
  data-edit={edit}>
  <Text text={text} />
</p>

<style>
  .caption {
    margin: 0;
    align-self: end;
    justify-self: center;
    font-size: var(--np-fs-xs);
    line-height: 1;
    color: var(--np-color-ink-soft);
  }
</style>
