---
// 写真。src があれば画像、illustration があればイラスト（SVG）を入れる
import { illustrations } from "../illustrations";
import type { Area, PhotoData } from "../types";
import { place } from "../utils";

interface Props {
  area: Area;
  photo: PhotoData;
  /** 右（見出し側）へ広げる量。例 "0.8em"。見出しとの間を詰めたいときに使う */
  extendRight?: string;
  /** エディター用。YAML での場所（例 "photoStory.photo"） */
  edit?: string;
}

const { area, photo, extendRight, edit } = Astro.props;
const Illustration =
  "illustration" in photo ? illustrations[photo.illustration] : null;
---

<figure
  class="photo"
  data-edit={edit}
  style={place(area) + (extendRight ? ` margin-right: calc(${extendRight} * -1);` : "")}
>
  {
    Illustration ? (
      <Illustration label={photo.alt} />
    ) : (
      "src" in photo && <img src={photo.src} alt={photo.alt} />
    )
  }
</figure>

<style>
  .photo {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
